--// SILENCE
--// Model: 125171553498127
--// Shatter: 8828938165
--// Crucifix Color: RGB(91,197,232)

local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Workspace=game:GetService("Workspace")
local Player=Players.LocalPlayer

if _G.SilenceController then
	_G.SilenceController.Active=false
end

local old=Workspace:FindFirstChild("Silence")
if old then old:Destroy() end

local Controller={Active=true}
_G.SilenceController=Controller

local CurrentRooms=Workspace:WaitForChild("CurrentRooms",15)
local GameData=ReplicatedStorage:WaitForChild("GameData",15)
local LatestRoom=GameData and GameData:WaitForChild("LatestRoom",15)

if not CurrentRooms or not LatestRoom then
	Controller.Active=false
	return
end

--// LOAD FUNCTIONS
local Functions

pcall(function()
	Functions=loadstring(game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"
	))()
end)

--// LOAD MODEL
local function LoadModel()
	local Model

	if Functions and Functions.LoadCustomInstance then
		pcall(function()
			Model=Functions.LoadCustomInstance(
				"rbxassetid://125171553498127"
			)
		end)
	end

	if not Model then
		pcall(function()
			local Objects=game:GetObjects(
				"rbxassetid://125171553498127"
			)
			Model=Objects and Objects[1]
		end)
	end

	return Model
end

local Silence=LoadModel()

if not Silence then
	warn("[Silence] Model failed to load")
	Controller.Active=false
	return
end

--// MODEL SETUP
if not Silence:IsA("Model") then
	local Model=Instance.new("Model")
	Silence.Parent=Model
	Silence=Model
end

Silence.Name="Silence"
Silence.Parent=Workspace

local Root

for _,v in ipairs(Silence:GetDescendants()) do
	if v:IsA("BasePart") then
		Root=v
		break
	end
end

if not Root then
	Silence:Destroy()
	Controller.Active=false
	return
end

Silence.PrimaryPart=Root

--// CRUCIFIX
Silence:SetAttribute("IsCustomEntity",true)
Silence:SetAttribute("CrucifixCompatible",true)
Silence:SetAttribute(
	"CrucifixColor",
	Color3.fromRGB(91,197,232)
)

for _,v in ipairs(Silence:GetDescendants()) do
	if v:IsA("BasePart") then
		v.Anchored=true
		v.CanCollide=false
		v.CanTouch=false
		v.CanQuery=false
	end
end

--// CURRENT ROOM
local RoomNumber=tonumber(LatestRoom.Value)
local SpawnRoom=RoomNumber
	and CurrentRooms:FindFirstChild(tostring(RoomNumber))

if not SpawnRoom then
	for _,Room in ipairs(CurrentRooms:GetChildren()) do
		local Number=tonumber(Room.Name)

		if Number and (not RoomNumber or Number>RoomNumber) then
			RoomNumber=Number
			SpawnRoom=Room
		end
	end
end

--// SPAWN POSITION
local SpawnPosition

if SpawnRoom then
	local Parts=SpawnRoom:FindFirstChild("Parts")
	local Floor=Parts and Parts:FindFirstChild("Floor")

	if Floor and Floor:IsA("BasePart") then
		SpawnPosition=
			Floor.Position+
			Vector3.new(0,13.5,0)
	else
		local CF,Size=SpawnRoom:GetBoundingBox()

		SpawnPosition=
			CF.Position+
			Vector3.new(0,Size.Y/2+13.5,0)
	end
end

if not SpawnPosition then
	local Character=
		Player.Character or Player.CharacterAdded:Wait()

	local HRP=Character:FindFirstChild("HumanoidRootPart")

	if HRP then
		SpawnPosition=
			HRP.Position+
			Vector3.new(0,13.5,0)
	end
end

if not SpawnPosition then
	Silence:Destroy()
	Controller.Active=false
	return
end

Silence:PivotTo(CFrame.new(SpawnPosition))

--// CROUCH CHECK
local function IsCrouching()
	local Character=Player.Character
	local Humanoid=
		Character and Character:FindFirstChildOfClass("Humanoid")

	if not Character or not Humanoid then
		return false
	end

	for _,Name in ipairs({
		"Crouching",
		"IsCrouching",
		"Crouched",
		"IsCrouched",
		"Crouch"
	}) do
		if Character:GetAttribute(Name)==true
			or Humanoid:GetAttribute(Name)==true then
			return true
		end

		local Value=Character:FindFirstChild(Name,true)

		if Value
			and Value:IsA("BoolValue")
			and Value.Value then
			return true
		end
	end

	return Humanoid.WalkSpeed<=9
end

--// DAMAGE
task.spawn(function()
	while Controller.Active and Silence.Parent do
		task.wait(1)

		local Character=Player.Character
		local Humanoid=
			Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid
			and Humanoid.Health>0
			and not IsCrouching() then

			pcall(function()
				Humanoid:TakeDamage(10)
			end)
		end
	end
end)

--// SHATTER
local function Shatter(Room)
	if not Room then return end

	for i=1,3 do
		task.spawn(function()
			if i>1 then
				task.wait(math.random(2,8)/100)
			end

			if not Controller.Active then return end

			local Sound=Instance.new("Sound")
			Sound.SoundId="rbxassetid://8828938165"
			Sound.Volume=.5
			Sound.PlaybackSpeed=math.random(90,110)/100
			Sound.Parent=Workspace
			Sound:Play()

			task.delay(2,function()
				if Sound then Sound:Destroy() end
			end)
		end)
	end

	pcall(function()
		for _,v in ipairs(Room:GetDescendants()) do
			if v:IsA("Light") then
				v.Enabled=false
			elseif v:IsA("BasePart") and (
				v.Name=="Glow"
				or v.Name=="Neon"
				or v.Name=="LightFixture"
			) then
				v.Material=Enum.Material.Glass
				v.Color=Color3.fromRGB(50,50,50)
			end
		end
	end)
end

Shatter(SpawnRoom)

--// REMOVE WHEN NEXT ROOM OPENS
task.spawn(function()
	while Controller.Active do
		task.wait(.1)

		if tonumber(LatestRoom.Value)~=RoomNumber then
			Controller.Active=false

			if Silence and Silence.Parent then
				Silence:Destroy()
			end

			break
		end
	end
end)

--// CLEANUP
Silence.AncestryChanged:Connect(function(_,Parent)
	if not Parent then
		Controller.Active=false
	end
end)

print(
	"[Silence] Spawned | Room:",
	RoomNumber,
	"| CrucifixColor: RGB(91,197,232)"
)
