local function AddPickupLights(
	object
)
	local main =
		GetMainPart(object)
	if not main then
		return
	end
	local red =
		main:FindFirstChild(
			"InnerRedLight"
		)
	if not red then
		red =
			Instance.new(
				"PointLight"
			)
		red.Name =
			"InnerRedLight"
		red.Parent =
			main
	end
	red.Color =
		Color3.fromRGB(
			255,
			0,
			0
		)
	red.Brightness = 10
	red.Range = 1
	red.Shadows = false
	red.Enabled = true
	local cyan =
		main:FindFirstChild(
			"OuterCyanLight"
		)
	if not cyan then
		cyan =
			Instance.new(
				"PointLight"
			)
		cyan.Name =
			"OuterCyanLight"
		cyan.Parent =
			main
	end
	cyan.Color =
		Color3.fromRGB(
			0,
			255,
			255
		)
	cyan.Brightness = 3
	cyan.Range = 10
	cyan.Shadows = false
	cyan.Enabled = true
end
local function RemovePickupLights(
	object
)
	for _, obj in ipairs(
		object:GetDescendants()
	) do
		if obj:IsA("PointLight")
			and (
				obj.Name ==
					"InnerRedLight"
				or obj.Name ==
					"OuterCyanLight"
			) then
			obj:Destroy()
		end
	end
end
--==================================================
-- ROOM LOCATIONS
--==================================================
local function GetRoomLocations(
	room
)
	local locations = {}
	for _, desc in ipairs(
		room:GetDescendants()
	) do
		if not desc:IsA("Model") then
			continue
		end
		local main =
			desc:FindFirstChild(
				"Main"
			)
		if not main
			or not main:IsA("BasePart") then
			continue
		end
		if desc.Name ==
			"DrawerContainer"
			and LOCATIONS.Drawers then
			table.insert(
				locations,
				{
					Part = main,
					CFrame =
						main.CFrame
						* CFrame.new(
							0,
							0.15,
							0
						),
					Type = "Drawer"
				}
			)
		elseif desc.Name ==
			"Table"
			and LOCATIONS.Tables then
			table.insert(
				locations,
				{
					Part = main,
					CFrame =
						main.CFrame
						* CFrame.new(
							0,
							main.Size.Y / 2
								+ 0.15,
							0
						),
					Type = "Table"
				}
			)
		elseif desc.Name:lower():find(
			"chest"
		)
			and LOCATIONS.Chests then
			table.insert(
				locations,
				{
					Part = main,
					CFrame =
						main.CFrame
						* CFrame.new(
							0,
							0.15,
							0
						),
					Type = "Chest"
				}
			)
		end
	end
	return locations
end
--==================================================
-- FIND CURRENT PLAYER ROOM
--==================================================
local function GetCurrentPlayerRoom()
	local rooms =
		Workspace:FindFirstChild(
			"CurrentRooms"
		)
	if not rooms then
		return nil
	end
	local character =
		LocalPlayer.Character
	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)
	if root then
		local closestRoom
		local closestDistance =
			math.huge
		for _, room in ipairs(
			rooms:GetChildren()
		) do
			local roomNumber =
				tonumber(room.Name)
			if roomNumber then
				local cf, size
				pcall(function()
					cf, size =
						room:GetBoundingBox()
				end)
				if cf and size then
					local pos =
						root.Position
					local minX =
						cf.Position.X
						- size.X / 2
					local maxX =
						cf.Position.X
						+ size.X / 2
					local minZ =
						cf.Position.Z
						- size.Z / 2
					local maxZ =
						cf.Position.Z
						+ size.Z / 2
					local inside =
						pos.X >= minX
						and pos.X <= maxX
						and pos.Z >= minZ
						and pos.Z <= maxZ
					if inside then
						return room
					end
					local distance =
						(
							Vector3.new(
								pos.X,
								0,
								pos.Z
							)
							-
							Vector3.new(
								cf.Position.X,
								0,
								cf.Position.Z
							)
						).Magnitude
					if distance < closestDistance then
						closestDistance =
							distance
						closestRoom =
							room
					end
				end
			end
		end
		if closestRoom then
			return closestRoom
		end
	end
	-- Fallback LatestRoom
	local gameData =
		ReplicatedStorage:FindFirstChild(
			"GameData"
		)
	if gameData then
		local latestRoom =
			gameData:FindFirstChild(
				"LatestRoom"
			)
		if latestRoom then
			local room =
				rooms:FindFirstChild(
					tostring(
						latestRoom.Value
					)
				)
			if room then
				return room
			end
		end
	end
	return nil
end
--==================================================
-- FIND SPAWN LOCATION
-- CURRENT ROOM + NEXT 4 ONLY
--==================================================
local function FindSpawnLocation()
	local rooms =
		Workspace:FindFirstChild(
			"CurrentRooms"
		)
	if not rooms then
		return nil
	end
	local currentRoom =
		GetCurrentPlayerRoom()
	if not currentRoom then
		return nil
	end
	local currentNumber =
		tonumber(
			currentRoom.Name
		)
	if not currentNumber then
		return nil
	end
	-- Current room + 4 next rooms
	for offset = 0, MAX_FORWARD_ROOMS do
		local roomNumber =
			currentNumber + offset
		if roomNumber < MIN_ROOM
			or roomNumber > MAX_ROOM then
			continue
		end
		local room =
			rooms:FindFirstChild(
				tostring(roomNumber)
			)
		-- Wait for room generation
		if not room then
			for _ = 1, 20 do
				task.wait(0.25)
				room =
					rooms:FindFirstChild(
						tostring(roomNumber)
					)
				if room then
					break
				end
			end
		end
		if room then
			local locations =
				GetRoomLocations(
					room
				)
			if #locations > 0 then
				local location =
					locations[
						math.random(
							1,
							#locations
						)
					]
				print(
					"[Crucifix] Spawned | Room "
					.. room.Name
					.. " | "
					.. location.Type
				)
				return room, location
			end
		end
	end
	warn(
		"[Crucifix] No Drawer/Table/Chest found in current room + next 4 rooms"
	)
	return nil
end
--==================================================
-- ENTITY SEARCH
--==================================================
local function FindNearestEntity()
	local character =
		LocalPlayer.Character
	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)
	if not root then
		return nil
	end
	local nearest
	local nearestDistance =
		CRUCIFIX_RANGE
	for _, object in ipairs(
		Workspace:GetDescendants()
	) do
		if not object:IsA("Model") then
			continue
		end
		local entityName =
			object:GetAttribute(
				"EntityName"
			)
			or object.Name
		local known =
			entityName == "Silence"
			or entityName == "WH1T3"
			or entityName == "Smiler"
			or entityName == "smiler"
			or entityName == "HungerMoving"
			or entityName == "Common Sense"
			or entityName == "Dimensional Eye"
			or entityName == "Blink"
		local compatible =
			object:GetAttribute(
				"CrucifixCompatible"
			) == true
		local custom =
			object:GetAttribute(
				"IsCustomEntity"
			) == true
		local canCrucify =
			object:GetAttribute(
				"CanBeCrucified"
			) == true
		if not (
			known
			or compatible
			or custom
			or canCrucify
		) then
			continue
		end
		if object:GetAttribute(
			"GoingToHell"
		) then
			continue
		end
		local primary =
			object.PrimaryPart
			or object:FindFirstChild(
				"HumanoidRootPart",
				true
			)
			or object:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
		if not primary then
			continue
		end
		local distance =
			(
				root.Position
				- primary.Position
			).Magnitude
		if distance <
			nearestDistance then
			nearest =
				object
			nearestDistance =
				distance
		end
	end
	return nearest
end
--==================================================
-- CRUCIFIX EFFECT
--==================================================
local function HellModel(
	Model
)
	if not Model then
		return
	end
	local fake =
		Model:Clone()
	fake.Name =
		"Fake" .. Model.Name
	fake.Parent =
		Workspace
	Model:Destroy()
	local PrimaryPart =
		fake.PrimaryPart
		or fake:FindFirstChild(
			"HumanoidRootPart",
			true
		)
		or fake:FindFirstChildWhichIsA(
			"BasePart",
			true
		)
	if not PrimaryPart then
		fake:Destroy()
		return
	end
	-- Stop entity sounds
	for _, obj in ipairs(
		fake:GetDescendants()
	) do
		if obj:IsA("Sound") then
			obj:Stop()
			obj.Volume = 0
		end
	end
	local entityName =
		Model:GetAttribute(
			"EntityName"
		)
		or Model.Name
	local entityColor =
		GetEntityColor(
			entityName,
			Model
		)
	local Repentance =
		BaseRepentance:Clone()
	Repentance.Parent =
		Workspace
	ColorRepentance(
		Repentance,
		entityColor
	)
	local Pentagram =
		Repentance:FindFirstChild(
			"Pentagram"
		)
	local Glow =
		Repentance:FindFirstChild(
			"Glow",
			true
		)
	local RepentanceCrucifix =
		Repentance:FindFirstChild(
			"Crucifix",
			true
		)
	local Entity =
		Repentance:FindFirstChild(
			"Entity",
			true
		)
	if not Pentagram
		or not Glow
		or not RepentanceCrucifix then
		Repentance:Destroy()
		fake:Destroy()
		return
	end
	-- Floor raycast
	local RayParams =
		RaycastParams.new()
	RayParams.FilterType =
		Enum.RaycastFilterType.Exclude
	RayParams.FilterDescendantsInstances = {
		Character,
		fake,
		Repentance
	}
	local RayResult =
		Workspace:Raycast(
			PrimaryPart.Position,
			Vector3.new(
				0,
				-20,
				0
			),
			RayParams
		)
	if RayResult then
		local FloorPart =
			Instance.new("Part")
		FloorPart.Anchored =
			true
		FloorPart.Transparency =
			1
		FloorPart.CanCollide =
			false
		FloorPart.Position =
			RayResult.Position
			+ Vector3.new(
				0,
				1,
				0
			)
		FloorPart.Parent =
			Workspace
		Repentance:PivotTo(
			FloorPart.CFrame
			* CFrame.new(
				0,
				-0.5,
				0
			)
		)
		FloorPart:Destroy()
	else
		Repentance:PivotTo(
			PrimaryPart.CFrame
		)
	end
	-- Anchor entity
	for _, obj in ipairs(
		fake:GetDescendants()
	) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
		end
	end
	local character =
		LocalPlayer.Character
	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)
	if root then
		RepentanceCrucifix:PivotTo(
			root.CFrame
			* CFrame.new(
				0,
				3.5,
				-6
			)
		)
	end
	-- Glow
	Glow.Anchored = false
	local sound =
		Glow:FindFirstChild(
			"Sound"
		)
	if sound then
		sound:Play()
	end
	local bodyAngular =
		Glow:FindFirstChild(
			"BodyAngularVelocity"
		)
	local bodyPosition =
		Glow:FindFirstChild(
			"BodyPosition"
		)
	if bodyAngular then
		bodyAngular.AngularVelocity =
			Vector3.zero
	end
	if bodyPosition and root then
		bodyPosition.Position =
			(
				root.CFrame
				* CFrame.new(
					0,
					3.5,
					-6
				)
			).Position
	end
	-- Camera shake
	CameraShake:ShakeOnce(
		10,
		15,
		4,
		5
	)
	-- Custom sound
	if CustomSound then
		local custom =
			Instance.new("Sound")
		custom.SoundId =
			CustomSound
		custom.Volume = 7
		custom.Parent =
			Workspace
		custom:Play()
		custom.Ended:Connect(
			function()
				if custom.Parent then
					custom:Destroy()
				end
			end
		)
	end
	-- Pentagram
	task.spawn(function()
		local circle =
			Pentagram:FindFirstChild(
				"Circle"
			)
		if not circle then
			return
		end
		TweenService:Create(
			circle,
			TweenInfo.new(
				1,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Position =
					circle.Position
					- Vector3.new(
						0,
						7.5,
						0
					)
			}
		):Play()
		task.wait(1)
		circle.Anchored = false
		if bodyAngular then
			TweenService:Create(
				bodyAngular,
				TweenInfo.new(
					2.5,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.In
				),
				{
					AngularVelocity =
						Vector3.new(
							0,
							30,
							0
						)
				}
			):Play()
			task.wait(4)
			TweenService:Create(
				bodyAngular,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					AngularVelocity =
						Vector3.zero
				}
			):Play()
		end
	end)
	-- Entity animation
	task.spawn(function()
		task.wait(1.5)
		if Entity then
			TweenService:Create(
				Entity,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.In
				),
				{
					Position =
						Entity.Position
						+ Vector3.new(
							0,
							3.5,
							0
						)
				}
			):Play()
		end
		for _, Part in ipairs(
			fake:GetDescendants()
		) do
			if Part:IsA("BasePart") then
				TweenService:Create(
					Part,
					TweenInfo.new(
						1.5,
						Enum.EasingStyle.Back,
						Enum.EasingDirection.In
					),
					{
						Position =
							Part.Position
							+ Vector3.new(
								0,
								3.5,
								0
							)
					}
				):Play()
			end
		end
		task.wait(1.5)
		if Entity then
			TweenService:Create(
				Entity,
				TweenInfo.new(
					2,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.InOut
				),
				{
					Position =
						Entity.Position
						- Vector3.new(
							0,
							50,
							0
						)
				}
			):Play()
		end
		for _, Part in ipairs(
			fake:GetDescendants()
		) do
			if Part:IsA("BasePart") then
				TweenService:Create(
					Part,
					TweenInfo.new(
						2,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.InOut
					),
					{
						Position =
							Part.Position
							- Vector3.new(
								0,
								50,
								0
							)
					}
				):Play()
			end
		end
		for _, obj in ipairs(
			fake:GetDescendants()
		) do
			if obj:IsA("Sound") then
				TweenService:Create(
					obj,
					TweenInfo.new(
						1,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.InOut
					),
					{
						Volume = 0
					}
				):Play()
			end
		end
	end)
	-- Light
	task.spawn(function()
		task.wait(0.5)
		local lightBright =
			Pentagram:FindFirstChild(
				"LightBright",
				true
			)
		if lightBright
			and lightBright:IsA("Light") then
			TweenService:Create(
				lightBright,
				TweenInfo.new(
					2,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				),
				{
					Range = 30,
					Brightness = 5
				}
			):Play()
			task.wait(1.75)
			TweenService:Create(
				lightBright,
				TweenInfo.new(
					4,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					Range = 1,
					Brightness = 0
				}
			):Play()
		end
	end)
	task.wait(6.5)
	-- Final glow
	local glowLight =
		Glow:FindFirstChild(
			"Light"
		)
	if glowLight
		and glowLight:IsA("Light") then
		glowLight.Enabled =
			false
	end
	TweenService:Create(
		Glow,
		TweenInfo.new(
			1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size =
				Glow.Size * 3.5
		}
	):Play()
	TweenService:Create(
		Glow,
		TweenInfo.new(
			1.25,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Transparency = 1
		}
	):Play()
	local particle =
		Glow:FindFirstChild(
			"ExplodeParticle"
		)
	if particle
		and particle:IsA(
			"ParticleEmitter"
		) then
		particle:Emit(50)
	end
	CameraShake:ShakeOnce(
		3,
		10,
		0.7,
		0.5
	)
	task.wait(2.5)
	if Repentance
		and Repentance.Parent then
		Repentance:Destroy()
	end
	if fake
		and fake.Parent then
		fake:Destroy()
	end
end
--==================================================
-- EQUIP LOGIC
--==================================================
local function SetupCrucifix(
	tool
)
	local active = false
	local used = false
	local connection
	tool.Equipped:Connect(
		function()
			if used then
				return
			end
			active = true
			if connection then
				connection:Disconnect()
			end
			connection =
				RunService.Heartbeat:Connect(
					function()
						if not active
							or used
							or not tool.Parent then
							return
						end
						local entity =
							FindNearestEntity()
						if not entity then
							return
						end
						used = true
						active = false
						if connection then
							connection:Disconnect()
							connection = nil
						end
						entity:SetAttribute(
							"GoingToHell",
							true
						)
						tool:Destroy()
						task.spawn(
							function()
								HellModel(
									entity
								)
							end
						)
					end
				)
		end
	)
	tool.Unequipped:Connect(
		function()
			active = false
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end
	)
end
--==================================================
-- SPAWN CRUCIFIX
--==================================================
local function SpawnCrucifix()
	if math.random(
		1,
		100
	) > SPAWN_CHANCE then
		return
	end
	local room, location =
		FindSpawnLocation()
	if not room
		or not location then
		warn(
			"[Crucifix] No valid spawn location"
		)
		return
	end
	local pickup =
		BaseCrucifix:Clone()
	pickup.Name =
		"Cruxy"
	pickup.Parent =
		Workspace
	-- Remove scripts/prompts
	for _, obj in ipairs(
		pickup:GetDescendants()
	) do
		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("ProximityPrompt") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = true
		end
	end
	local pickupPart =
		GetMainPart(
			pickup
		)
	if not pickupPart then
		pickup:Destroy()
		return
	end
	local spawnCFrame =
		location.CFrame
		* CFrame.Angles(
			math.rad(90),
			0,
			math.rad(
				math.random(
					0,
					359
				)
			)
		)
	PivotObject(
		pickup,
		spawnCFrame
	)
	-- Attach to furniture
	local weld =
		Instance.new(
			"WeldConstraint"
		)
	weld.Part0 =
		location.Part
	weld.Part1 =
		pickupPart
	weld.Parent =
		pickupPart
	-- Lights
	AddPickupLights(
		pickup
	)
	-- Prompt
	local prompt =
		Instance.new(
			"ProximityPrompt"
		)
	prompt.Name =
		"CrucifixPrompt"
	prompt.ActionText =
		"Pick Up"
	prompt.ObjectText =
		"Crucifix"
	prompt.MaxActivationDistance =
		PROMPT_RANGE
	prompt.HoldDuration =
		PROMPT_HOLD
	prompt.RequiresLineOfSight =
		false
	prompt.Parent =
		pickupPart
	local pickedUp = false
	prompt.Triggered:Connect(
		function(player)
			if pickedUp then
				return
			end
			if player ~= LocalPlayer then
				return
			end
			pickedUp = true
			pickup:Destroy()
			local tool =
				BaseCrucifix:Clone()
			tool.Name =
				"Crucifix"
			RemovePickupLights(
				tool
			)
			tool.Parent =
				LocalPlayer.Backpack
			SetupCrucifix(
				tool
			)
			pcall(function()
				MainGame.caption(
					"You grab the crucifix.",
					true
				)
				task.wait(3)
				MainGame.caption(
					'It has a text on the back: "Made in China"',
					true
				)
				task.wait(3)
				MainGame.caption(
					"It only works with custom entities.",
					true
				)
			end)
		end
	)
	print(
		"[Crucifix] Spawned | Room "
		.. room.Name
		.. " | "
		.. location.Type
	)
end
