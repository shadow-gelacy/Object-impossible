--==================================================
-- ENTITY COLORS
--==================================================
local function GetEntityColor(
	entityName,
	entity
)
	if entity then
		local customColor =
			entity:GetAttribute(
				"CrucifixColor"
			)
		if typeof(customColor) == "Color3" then
			return customColor
		end
	end
	if entityName == "Silence" then
		return Color3.fromRGB(
			255,
			255,
			255
		)
	elseif entityName == "WH1T3" then
		return Color3.fromRGB(
			0,
			0,
			255
		)
	elseif entityName == "Smiler"
		or entityName == "smiler" then
		return Color3.fromRGB(
			255,
			0,
			0
		)
	elseif entityName == "HungerMoving" then
		return Color3.fromRGB(
			59,
			6,
			6
		)
	elseif entityName == "Common Sense" then
		return Color3.fromRGB(
			117,
			117,
			117
		)
	elseif entityName == "Dimensional Eye" then
		return Color3.fromRGB(
			31,
			29,
			43
		)
	elseif entityName == "Blink" then
		return Color3.fromRGB(
			216,
			0,
			240
		)
	end
	return Color3.fromRGB(
		255,
		255,
		255
	)
end
--==================================================
-- COLOR REPENTANCE
--==================================================
local function ColorRepentance(
	model,
	color
)
	for _, obj in ipairs(
		model:GetDescendants()
	) do
		if obj:IsA("BasePart") then
			obj.Color = color
		elseif obj:IsA("Light") then
			obj.Color = color
		elseif obj:IsA("ParticleEmitter") then
			obj.Color =
				ColorSequence.new(color)
		elseif obj:IsA("Beam") then
			obj.Color =
				ColorSequence.new(color)
		end
	end
end
--==================================================
-- MAIN PART
--==================================================
local function GetMainPart(
	object
)
	if object:IsA("BasePart") then
		return object
	end
	if object:IsA("Tool") then
		return object:FindFirstChild(
			"Handle",
			true
		)
	end
	if object:IsA("Model") then
		if object.PrimaryPart then
			return object.PrimaryPart
		end
		local handle =
			object:FindFirstChild(
				"Handle",
				true
			)
		if handle then
			return handle
		end
	end
	return object:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end
--==================================================
-- PIVOT
--==================================================
local function PivotObject(
	object,
	cf
)
	if object:IsA("Model") then
		object:PivotTo(cf)
	elseif object:IsA("Tool") then
		local handle =
			object:FindFirstChild(
				"Handle",
				true
			)
		if handle then
			handle.CFrame = cf
		end
	elseif object:IsA("BasePart") then
		object.CFrame = cf
	end
end
