local ASSET = "rbxassetid://12849323184"
local SOUND_URL = "https://raw.githubusercontent.com/shadow-gelacy/Object-impossible/main/stress.mp3"
local MIN_ROOM, MAX_ROOM = 0, 100
local SPAWN_CHANCE = 100
local RANGE, PROMPT_RANGE = 70, 7
local MAX_FORWARD_ROOMS = 4

local LOCATIONS = {Drawers = true, Tables = true, Chests = true}
local COLORS = {
    Silence = Color3.fromRGB(224,255,255),
    WH1T3 = Color3.fromRGB(0,0,255),
    Smiler = Color3.fromRGB(255,0,0),
    smiler = Color3.fromRGB(255,0,0),
    HungerMoving = Color3.fromRGB(224,255,255),
    ["Common Sense"] = Color3.fromRGB(224,255,255),
    ["Dimensional Eye"] = Color3.fromRGB(255,226,136),
    Blink = Color3.fromRGB(224,255,255)
}

local ok, asset = pcall(function()
    return game:GetObjects(ASSET)[1]
end)
if not ok or not asset then return end

local BaseCrucifix = asset:FindFirstChild("Crucifix", true)
local BaseRepentance = asset:FindFirstChild("Repentance", true)
if not BaseCrucifix or not BaseRepentance then
    asset:Destroy()
    return
end

local CustomSound
pcall(function()
    if not isfile("custom_crucifix_sound.mp3") then
        writefile("custom_crucifix_sound.mp3", game:HttpGet(SOUND_URL))
    end
    CustomSound = getcustomasset("custom_crucifix_sound.mp3")
end)

local function MainPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Tool") then
        return obj:FindFirstChild("Handle", true)
    end
    if obj:IsA("Model") and obj.PrimaryPart then
        return obj.PrimaryPart
    end
    return obj:FindFirstChild("Handle", true)
        or obj:FindFirstChildWhichIsA("BasePart", true)
end

local function Pivot(obj, cf)
    if obj:IsA("Model") then
        obj:PivotTo(cf)
    elseif obj:IsA("BasePart") then
        obj.CFrame = cf
    elseif obj:IsA("Tool") then
        local part = MainPart(obj)
        if part then part.CFrame = cf end
    end
end

local function ColorModel(model, color)
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Light") then
            obj.Color = color
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") then
            obj.Color = ColorSequence.new(color)
        end
    end
end

local function AddLights(obj)
    local part = MainPart(obj)
    if not part then return end

    for _, data in ipairs({
        {"InnerRedLight", Color3.fromRGB(255,0,0), 10, 1},
        {"OuterCyanLight", Color3.fromRGB(0,255,255), 3, 10}
    }) do
        local light = part:FindFirstChild(data[1]) or Instance.new("PointLight")
        light.Name, light.Color = data[1], data[2]
        light.Brightness, light.Range = data[3], data[4]
        light.Shadows, light.Parent = false, part
    end
end

local function RemoveLights(obj)
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("PointLight") and (v.Name == "InnerRedLight" or v.Name == "OuterCyanLight") then
            v:Destroy()
        end
    end
end

local function CurrentRoom()
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not rooms or not root then return nil end

    local nearest, distance = nil, math.huge
    for _, room in ipairs(rooms:GetChildren()) do
        if tonumber(room.Name) then
            local ok, cf, size = pcall(function()
                local c, s = room:GetBoundingBox()
                return c, s
            end)
            if ok and cf and size then
                local p = cf:PointToObjectSpace(root.Position)
                if math.abs(p.X) <= size.X/2 and math.abs(p.Z) <= size.Z/2 then
                    return room
                end
                local d = (Vector3.new(root.Position.X,0,root.Position.Z)
                    - Vector3.new(cf.Position.X,0,cf.Position.Z)).Magnitude
                if d < distance then nearest, distance = room, d end
            end
        end
    end
    return nearest
end

local function FindSpawn()
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    local current = CurrentRoom()
    if not rooms or not current then return end

    local currentNumber = tonumber(current.Name)
    if not currentNumber then return end

    for offset = 0, MAX_FORWARD_ROOMS do
        local number = currentNumber + offset
        if number >= MIN_ROOM and number <= MAX_ROOM then
            local room = rooms:FindFirstChild(tostring(number))
            if not room then
                for _ = 1, 20 do
                    task.wait(.25)
                    room = rooms:FindFirstChild(tostring(number))
                    if room then break end
                end
            end

            if room then
                local choices = {}
                for _, obj in ipairs(room:GetDescendants()) do
                    if obj:IsA("Model") then
                        local main = obj:FindFirstChild("Main")
                        if main and main:IsA("BasePart") then
                            if obj.Name == "DrawerContainer" and LOCATIONS.Drawers then
                                table.insert(choices, {Part=main, CF=main.CFrame*CFrame.new(0,.15,0), Type="Drawer"})
                            elseif obj.Name == "Table" and LOCATIONS.Tables then
                                table.insert(choices, {Part=main, CF=main.CFrame*CFrame.new(0,main.Size.Y/2+.15,0), Type="Table"})
                            elseif obj.Name:lower():find("chest") and LOCATIONS.Chests then
                                table.insert(choices, {Part=main, CF=main.CFrame*CFrame.new(0,.15,0), Type="Chest"})
                            end
                        end
                    end
                end
                if #choices > 0 then
                    return room, choices[math.random(1,#choices)]
                end
            end
        end
    end
end

local function FindEntity()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local nearest, best = nil, RANGE
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj:GetAttribute("EntityName") or obj.Name
            local compatible = obj:GetAttribute("CrucifixCompatible") == true
                or obj:GetAttribute("CanBeCrucified") == true
                or obj:GetAttribute("IsCustomEntity") == true
                or COLORS[name] ~= nil

            if compatible and not obj:GetAttribute("GoingToHell") then
                local part = MainPart(obj)
                if part then
                    local d = (root.Position-part.Position).Magnitude
                    if d < best then nearest, best = obj, d end
                end
            end
        end
    end
    return nearest
end

local function Banish(model)
    if not model or not model.Parent then return end

    local name = model:GetAttribute("EntityName") or model.Name
    local color = model:GetAttribute("CrucifixColor")
    if typeof(color) ~= "Color3" then
        color = COLORS[name] or Color3.new(1,1,1)
    end

    local fake = model:Clone()
    fake.Name = "Fake"..name
    fake.Parent = Workspace
    model:Destroy()

    local part = MainPart(fake)
    if not part then fake:Destroy() return end

    for _, obj in ipairs(fake:GetDescendants()) do
        if obj:IsA("Sound") then obj:Stop(); obj.Volume = 0 end
        if obj:IsA("BasePart") then obj.Anchored = true end
    end

    local effect = BaseRepentance:Clone()
    effect.Parent = Workspace
    ColorModel(effect, color)

    local pentagram = effect:FindFirstChild("Pentagram")
    local glow = effect:FindFirstChild("Glow", true)
    local crucifix = effect:FindFirstChild("Crucifix", true)
    local entity = effect:FindFirstChild("Entity", true)

    if not pentagram or not glow or not crucifix then
        effect:Destroy()
        fake:Destroy()
        return
    end

    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, fake, effect}

    local hit = Workspace:Raycast(part.Position, Vector3.new(0,-20,0), params)
    effect:PivotTo(hit and CFrame.new(hit.Position) or part.CFrame)

    if root then crucifix:PivotTo(root.CFrame*CFrame.new(0,3.5,-6)) end

    local sound = glow:FindFirstChild("Sound")
    if sound then sound:Play() end

    local bodyAngular = glow:FindFirstChild("BodyAngularVelocity")
    local bodyPosition = glow:FindFirstChild("BodyPosition")
    if bodyAngular then bodyAngular.AngularVelocity = Vector3.zero end
    if bodyPosition and root then bodyPosition.Position = (root.CFrame*CFrame.new(0,3.5,-6)).Position end

    CameraShake:ShakeOnce(10,15,4,5)

    if CustomSound then
        local s = Instance.new("Sound")
        s.SoundId, s.Volume, s.Parent = CustomSound, 7, Workspace
        s:Play()
        s.Ended:Connect(function() s:Destroy() end)
    end

    task.spawn(function()
        local circle = pentagram:FindFirstChild("Circle")
        if circle then
            TweenService:Create(circle, TweenInfo.new(1,Enum.EasingStyle.Quad,Enum.EasingDirection.Out), {
                Position=circle.Position-Vector3.new(0,7.5,0)
            }):Play()
            task.wait(1)
            circle.Anchored = false
        end
        if bodyAngular then
            TweenService:Create(bodyAngular,TweenInfo.new(2.5),{AngularVelocity=Vector3.new(0,30,0)}):Play()
            task.wait(4)
            TweenService:Create(bodyAngular,TweenInfo.new(1.5),{AngularVelocity=Vector3.zero}):Play()
        end
    end)

    task.spawn(function()
        task.wait(1.5)
        for _, obj in ipairs(fake:GetDescendants()) do
            if obj:IsA("BasePart") then
                TweenService:Create(obj,TweenInfo.new(1.5,Enum.EasingStyle.Back,Enum.EasingDirection.In),{
                    Position=obj.Position+Vector3.new(0,3.5,0)
                }):Play()
            end
        end
        if entity and entity:IsA("BasePart") then
            TweenService:Create(entity,TweenInfo.new(1.5),{Position=entity.Position+Vector3.new(0,3.5,0)}):Play()
        end
        task.wait(1.5)
        for _, obj in ipairs(fake:GetDescendants()) do
            if obj:IsA("BasePart") then
                TweenService:Create(obj,TweenInfo.new(2),{Position=obj.Position-Vector3.new(0,50,0)}):Play()
            elseif obj:IsA("Sound") then
                TweenService:Create(obj,TweenInfo.new(1),{Volume=0}):Play()
            end
        end
        if entity and entity:IsA("BasePart") then
            TweenService:Create(entity,TweenInfo.new(2),{Position=entity.Position-Vector3.new(0,50,0)}):Play()
        end
    end)

    task.spawn(function()
        task.wait(.5)
        local light = pentagram:FindFirstChild("LightBright",true)
        if light and light:IsA("Light") then
            TweenService:Create(light,TweenInfo.new(2),{Range=30,Brightness=5}):Play()
            task.wait(1.75)
            TweenService:Create(light,TweenInfo.new(4),{Range=1,Brightness=0}):Play()
        end
    end)

    task.wait(6.5)
    local light = glow:FindFirstChild("Light")
    if light and light:IsA("Light") then light.Enabled = false end

    TweenService:Create(glow,TweenInfo.new(1),{Size=glow.Size*3.5}):Play()
    TweenService:Create(glow,TweenInfo.new(1.25),{Transparency=1}):Play()

    local particle = glow:FindFirstChild("ExplodeParticle")
    if particle and particle:IsA("ParticleEmitter") then particle:Emit(50) end

    CameraShake:ShakeOnce(3,10,.7,.5)
    task.wait(2.5)
    effect:Destroy()
    fake:Destroy()
end

local function SetupCrucifix(tool)
    local active, used = false, false
    local connection

    tool.Equipped:Connect(function()
        if used then return end
        active = true
        if connection then connection:Disconnect() end

        connection = RunService.Heartbeat:Connect(function()
            if not active or used or not tool.Parent then return end
            local entity = FindEntity()
            if not entity then return end

            used, active = true, false
            connection:Disconnect()
            connection = nil
            entity:SetAttribute("GoingToHell",true)
            tool:Destroy()
            task.spawn(Banish,entity)
        end)
    end)

    tool.Unequipped:Connect(function()
        active = false
        if connection then connection:Disconnect(); connection=nil end
    end)
end

local function SpawnCrucifix()
    if math.random(1,100) > SPAWN_CHANCE then return end
    local room, location = FindSpawn()
    if not room or not location then return end

    local pickup = BaseCrucifix:Clone()
    pickup.Name, pickup.Parent = "Cruxy", Workspace

    for _, obj in ipairs(pickup:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("ProximityPrompt") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored, obj.CanCollide, obj.CanTouch, obj.CanQuery = true, false, false, true
        end
    end

    local part = MainPart(pickup)
    if not part then pickup:Destroy() return end

    Pivot(pickup,location.CF*CFrame.Angles(math.rad(90),0,math.rad(math.random(0,359))))

    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1, weld.Parent = location.Part, part, part
    AddLights(pickup)

    local prompt = Instance.new("ProximityPrompt")
    prompt.Name, prompt.ActionText, prompt.ObjectText = "CrucifixPrompt","Pick Up","Crucifix"
    prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = PROMPT_RANGE,0,false
    prompt.Parent = part

    local picked = false
    prompt.Triggered:Connect(function(player)
        if picked or player ~= Player then return end
        picked = true
        pickup:Destroy()

        local tool = BaseCrucifix:Clone()
        tool.Name = "Crucifix"
        RemoveLights(tool)
        tool.Parent = Player:WaitForChild("Backpack")
        SetupCrucifix(tool)

        pcall(function()
            MainGame.caption("You grab the crucifix.",true)
            task.wait(3)
            MainGame.caption('It has a text on the back: "Made in China"',true)
            task.wait(3)
            MainGame.caption("It only works with custom entities.",true)
        end)
    end)

    print("[Crucifix] Spawned | Room "..room.Name.." | "..location.Type)
end

task.wait(1)
SpawnCrucifix()
