local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")

local LocalPlayer = Players.LocalPlayer

local MODEL_URL =
	"https://raw.githubusercontent.com/shadow-gelacy/Model-loader-maker/main/Blink_Model_Cache.rbxm"

local HEIGHT_ABOVE_FLOOR = 3
local DAMAGE = 5
local DAMAGE_INTERVAL = 1
local CYCLE_TIME = 7
local SOUND_ID = "139658322785649"
local SOUND_VOLUME = 2

local gameData = ReplicatedStorage:WaitForChild("GameData")
local latestRoom = gameData:WaitForChild("LatestRoom")
local startingRoom = latestRoom.Value

local stopped = false
local movementDamageActive = false
local crucified = false

local BlinkFolder = Instance.new("Folder")
BlinkFolder.Name = "Blink"
BlinkFolder.Parent = Workspace

local blinkSound = Instance.new("Sound")
blinkSound.Name = "BlinkSound"
blinkSound.SoundId = "rbxassetid://" .. SOUND_ID
blinkSound.Volume = SOUND_VOLUME
blinkSound.Parent = SoundService

local function StopBlink()
	if crucified then
		return
	end

	crucified = true
	stopped = true
	movementDamageActive = false

	if blinkSound then
		blinkSound:Stop()
		blinkSound.TimePosition = 0
	end
end

local function playBlinkSound()
	if stopped or crucified then
		return
	end

	if model and model:GetAttribute("GoingToHell") == true then
		StopBlink()
		return
	end

	if not blinkSound or not blinkSound.Parent then
		return
	end

	blinkSound:Stop()
	blinkSound.TimePosition = 0
	blinkSound:Play()
end

local function loadRawModel(url)
	if not (writefile and getcustomasset) then
		warn("Blink: executor does not support writefile/getcustomasset.")
		return nil
	end

	local fileName = "Blink_" .. math.random(100000,999999) .. ".rbxm"

	local success, data = pcall(function()
		return game:HttpGet(url)
	end)

	if not success or not data then
		warn("Blink: failed to download model.")
		return nil
	end

	if not pcall(function()
		writefile(fileName,data)
	end) then
		warn("Blink: failed to write model file.")
		return nil
	end

	local asset

	if not pcall(function()
		asset = getcustomasset(fileName)
	end) or not asset then
		warn("Blink: getcustomasset failed.")
		return nil
	end

	local loaded

	if not pcall(function()
		local objects = game:GetObjects(asset)

		if objects and #objects > 0 then
			loaded = objects[1]
		end
	end) or not loaded then
		warn("Blink: could not load model.")
		return nil
	end

	if not loaded:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = "Blink"
		loaded.Parent = wrapper

		if loaded:IsA("BasePart") then
			wrapper.PrimaryPart = loaded
		else
			wrapper.PrimaryPart =
				loaded:FindFirstChildWhichIsA("BasePart",true)
		end

		loaded = wrapper
	end

	loaded.Name = "Blink"
	loaded.Parent = BlinkFolder

	loaded:SetAttribute("EntityName","Blink")
	loaded:SetAttribute("CrucifixCompatible",true)
	loaded:SetAttribute("CanBeCrucified",true)
	loaded:SetAttribute("IsCustomEntity",true)

	loaded:SetAttribute(
		"CrucifixColor",
		Color3.fromRGB(85,206,255)
	)

	loaded:SetAttribute("CrucifixType","Guiding")
	loaded:SetAttribute("CrucifixRange",40)
	loaded:SetAttribute("CrucifixResist",false)
	loaded:SetAttribute("CrucifixBreak",true)
	loaded:SetAttribute("Damage",DAMAGE)

	return loaded
end

local function getRoom()
	local rooms = Workspace:FindFirstChild("CurrentRooms")

	if not rooms then
		return nil
	end

	return rooms:FindFirstChild(tostring(latestRoom.Value))
end

local function getRoomCenter(room)
	if not room then
		return nil
	end

	local nodes = room:FindFirstChild("Nodes")

	if nodes then
		local minX,maxX = math.huge,-math.huge
		local minZ,maxZ = math.huge,-math.huge
		local found = false

		for _,obj in ipairs(nodes:GetChildren()) do
			if obj:IsA("BasePart") then
				local p = obj.Position

				minX = math.min(minX,p.X)
				maxX = math.max(maxX,p.X)
				minZ = math.min(minZ,p.Z)
				maxZ = math.max(maxZ,p.Z)

				found = true
			end
		end

		if found then
			return Vector3.new(
				(minX+maxX)/2,
				0,
				(minZ+maxZ)/2
			)
		end
	end

	local entrance = room:FindFirstChild("RoomEntrance")
	local exit = room:FindFirstChild("RoomExit")

	if entrance and exit
		and entrance:IsA("BasePart")
		and exit:IsA("BasePart") then

		return Vector3.new(
			(entrance.Position.X+exit.Position.X)/2,
			0,
			(entrance.Position.Z+exit.Position.Z)/2
		)
	end

	local pivot = room:GetPivot()

	return Vector3.new(
		pivot.Position.X,
		0,
		pivot.Position.Z
	)
end

local function getRealFloorY(room,center)
	if not room or not center then
		return nil
	end

	local nodes = room:FindFirstChild("Nodes")
	local referenceY

	if nodes then
		local lowestNodeY = math.huge

		for _,obj in ipairs(nodes:GetChildren()) do
			if obj:IsA("BasePart") then
				lowestNodeY = math.min(
					lowestNodeY,
					obj.Position.Y
				)
			end
		end

		if lowestNodeY ~= math.huge then
			referenceY = lowestNodeY
		end
	end

	referenceY = referenceY or room:GetPivot().Position.Y

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {room}
	params.IgnoreWater = true

	local result = Workspace:Raycast(
		Vector3.new(center.X,referenceY+8,center.Z),
		Vector3.new(0,-25,0),
		params
	)

	if result and result.Normal.Y > 0.5 then
		return result.Position.Y
	end

	return referenceY
end

local function getBottomY(obj)
	if obj:IsA("Model") then
		local cf,size = obj:GetBoundingBox()
		return cf.Position.Y-size.Y/2
	elseif obj:IsA("BasePart") then
		return obj.Position.Y-obj.Size.Y/2
	end
end

local function moveToRoomCenter(obj)
	if stopped or crucified or not obj or not obj:IsA("Model") then
		return
	end

	local room = getRoom()
	local center = room and getRoomCenter(room)

	if not center then
		return
	end

	local floorY = getRealFloorY(room,center)

	if not floorY then
		return
	end

	obj:PivotTo(CFrame.new(
		center.X,
		floorY+5,
		center.Z
	))

	task.wait()

	if stopped or crucified then
		return
	end

	local bottomY = getBottomY(obj)

	if not bottomY then
		return
	end

	obj:PivotTo(
		obj:GetPivot()
		+ Vector3.new(
			0,
			floorY+HEIGHT_ABOVE_FLOOR-bottomY,
			0
		)
	)
end

local model = loadRawModel(MODEL_URL)

if not model then
	if BlinkFolder then
		BlinkFolder:Destroy()
	end

	if blinkSound then
		blinkSound:Destroy()
	end

	return
end

task.wait()
moveToRoomCenter(model)

model:GetAttributeChangedSignal("GoingToHell"):Connect(function()
	if model:GetAttribute("GoingToHell") == true then
		StopBlink()
	end
end)

if model:GetAttribute("GoingToHell") == true then
	StopBlink()
end

latestRoom:GetPropertyChangedSignal("Value"):Connect(function()
	if latestRoom.Value ~= startingRoom then
		stopped = true
		movementDamageActive = false

		if blinkSound then
			blinkSound:Stop()
		end

		if BlinkFolder then
			BlinkFolder:Destroy()
		end

		if blinkSound then
			blinkSound:Destroy()
		end
	end
end)

task.spawn(function()
	while not stopped do
		task.wait(DAMAGE_INTERVAL)

		if stopped or crucified then
			break
		end

		if movementDamageActive
			and model
			and model.Parent
			and model:GetAttribute("GoingToHell") ~= true then

			local character = LocalPlayer.Character
			local humanoid = character
				and character:FindFirstChildOfClass("Humanoid")

			if humanoid
				and humanoid.Health > 0
				and humanoid.MoveDirection.Magnitude > 0.05 then

				humanoid:TakeDamage(DAMAGE)
			end
		end
	end
end)

task.spawn(function()
	task.wait(CYCLE_TIME)

	while not stopped and not crucified do
		if model and model:GetAttribute("GoingToHell") == true then
			StopBlink()
			break
		end

		playBlinkSound()

		if stopped or crucified then
			break
		end

		movementDamageActive = true
		task.wait(CYCLE_TIME)

		if stopped or crucified then
			break
		end

		if model and model:GetAttribute("GoingToHell") == true then
			StopBlink()
			break
		end

		movementDamageActive = false
		task.wait(CYCLE_TIME)
	end
end)

return {
	Name = "Blink",
	Damage = DAMAGE,
	Crucifixion = {
		Type = "Guiding",
		Enabled = true,
		Range = 70,
		Resist = false,
		Break = true
	},
	RoomLimit = 1
}
