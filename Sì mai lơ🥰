local Player = Players.LocalPlayer
if not Player then return end

local MODEL_ID = "rbxassetid://16618965725"
local FACE_ID = "rbxassetid://107386174037977"
local SOUND_ID = "rbxassetid://5263560566"
local CRUCIFIX_COLOR = Color3.fromRGB(255, 60, 60)

local AchievementGiven = false
local JumpscarePlaying = false
local Entity

local function LoadModule(url, name)
    local ok, result = pcall(function()
        local source = game:HttpGet(url)
        assert(type(source) == "string" and #source > 0, "Empty source")

        local chunk, compileError = loadstring(source)
        assert(chunk, compileError or "Compile failed")

        return chunk()
    end)

    if not ok then
        warn("[Smiler] " .. name .. " error: " .. tostring(result))
        return nil
    end

    return result
end

local Spawner = LoadModule(
    "https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau",
    "Spawner"
)

if type(Spawner) ~= "table" or type(Spawner.Create) ~= "function" then
    warn("[Smiler] Spawner unavailable")
    return
end

local Achievement = LoadModule(
    "https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua",
    "Achievement"
)

local function ConfigureCrucifix(model)
    if not model or not model:IsA("Model") then return end

    pcall(function()
        model:SetAttribute("CustomEntity", true)
        model:SetAttribute("CustomName", "Smiler")
        model:SetAttribute("CrucifixColor", CRUCIFIX_COLOR)
        model:SetAttribute("CanBeCrucified", true)

        if not model.PrimaryPart then
            local part = model:FindFirstChildWhichIsA("BasePart", true)
            if part then
                model.PrimaryPart = part
            end
        end
    end)
end

local function GiveAchievement()
    if AchievementGiven then return end
    AchievementGiven = true

    if type(Achievement) ~= "function" then
        warn("[Smiler] Achievement module unavailable")
        return
    end

    local ok, err = pcall(function()
        Achievement({
            Title = "how why?",
            Desc = "Don't leave hiding spot",
            Reason = "Encounter Smiler.",
            Image = MODEL_ID
        })
    end)

    if not ok then
        warn("[Smiler] Achievement error: " .. tostring(err))
    end
end

local function PlayJumpscare()
    if JumpscarePlaying then return end
    JumpscarePlaying = true

    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    local camera = Workspace.CurrentCamera

    if not playerGui or not camera then
        JumpscarePlaying = false
        return
    end

    local oldFov = camera.FieldOfView
    local oldType = camera.CameraType
    local oldSubject = camera.CameraSubject
    local oldCFrame = camera.CFrame

    local gui
    local sound
    local running = false

    local success, err = pcall(function()
        gui = Instance.new("ScreenGui")
        gui.Name = "SmilerJumpscare"
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10000
        gui.ResetOnSpawn = false
        gui.Parent = playerGui

        local background = Instance.new("Frame")
        background.Name = "BlackBackground"
        background.Size = UDim2.fromScale(1, 1)
        background.BackgroundColor3 = Color3.new(0, 0, 0)
        background.BorderSizePixel = 0
        background.ZIndex = 1
        background.Parent = gui

        local redFlash = Instance.new("Frame")
        redFlash.Name = "RedFlash"
        redFlash.Size = UDim2.fromScale(1, 1)
        redFlash.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        redFlash.BackgroundTransparency = 1
        redFlash.BorderSizePixel = 0
        redFlash.ZIndex = 2
        redFlash.Parent = gui

        local face = Instance.new("ImageLabel")
        face.Name = "SmilerFace"
        face.AnchorPoint = Vector2.new(0.5, 0.5)
        face.Position = UDim2.fromScale(0.5, 0.589)
        face.Size = UDim2.fromOffset(1, 1)
        face.BackgroundTransparency = 1
        face.Image = FACE_ID
        face.ScaleType = Enum.ScaleType.Fit
        face.ZIndex = 3
        face.Parent = gui

        sound = Instance.new("Sound")
        sound.Name = "SmilerSound"
        sound.SoundId = SOUND_ID
        sound.Volume = 10
        sound.Looped = true
        sound.Parent = Workspace

        local flange = Instance.new("FlangeSoundEffect")
        flange.Rate = 0.2
        flange.Parent = sound

        local tremolo = Instance.new("TremoloSoundEffect")
        tremolo.Frequency = 1
        tremolo.Parent = sound

        local pitch = Instance.new("PitchShiftSoundEffect")
        pitch.Octave = 1
        pitch.Parent = sound

        local distortion = Instance.new("DistortionSoundEffect")
        distortion.Level = 0.2
        distortion.Parent = sound

        sound:Play()
        camera.CameraType = Enum.CameraType.Scriptable

        local duration = 1.1

        TweenService:Create(camera, TweenInfo.new(duration), {
            FieldOfView = 60
        }):Play()

        TweenService:Create(
            face,
            TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Size = UDim2.fromOffset(1200, 1200),
                Position = UDim2.fromScale(0.5, 0.5)
            }
        ):Play()

        running = true

        task.spawn(function()
            while running and gui and gui.Parent do
                redFlash.BackgroundTransparency = 0.15
                task.wait(0.07)
                if not running then break end

                redFlash.BackgroundTransparency = 0.85
                task.wait(0.07)
                if not running then break end

                redFlash.BackgroundTransparency = 0.35
                task.wait(0.07)
                if not running then break end

                redFlash.BackgroundTransparency = 1
                task.wait(0.07)
            end
        end)

        task.spawn(function()
            while running and gui and gui.Parent do
                face.Rotation = 10
                task.wait(0.04)
                if not running then break end

                face.Rotation = -10
                task.wait(0.04)
            end
        end)

        task.spawn(function()
            while running and gui and gui.Parent do
                camera.CFrame = oldCFrame * CFrame.new(
                    math.random(-5, 5) / 100,
                    math.random(-5, 5) / 100,
                    0
                )
                task.wait(0.03)
            end
        end)

        task.wait(duration)
        running = false

        if sound then
            sound:Stop()
        end

        TweenService:Create(face, TweenInfo.new(0.5), {
            ImageTransparency = 1
        }):Play()

        TweenService:Create(redFlash, TweenInfo.new(0.5), {
            BackgroundTransparency = 1
        }):Play()

        task.wait(0.6)
    end)

    running = false

    if sound then sound:Destroy() end
    if gui then gui:Destroy() end

    if camera and camera.Parent then
        camera.CameraType = oldType
        camera.FieldOfView = oldFov

        if oldSubject and oldSubject.Parent then
            camera.CameraSubject = oldSubject
        end

        camera.CFrame = oldCFrame
    end

    JumpscarePlaying = false

    if not success then
        warn("[Smiler] Jumpscare error: " .. tostring(err))
    end
end

local function ConnectCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    humanoid.Died:Connect(function()
        task.spawn(PlayJumpscare)
    end)
end

if Player.Character then
    task.spawn(ConnectCharacter, Player.Character)
end

Player.CharacterAdded:Connect(ConnectCharacter)

