    warn("[Smiler] Create failed: " .. tostring(result))
    return
end

Entity = result

if type(Entity) ~= "table" then
    warn("[Smiler] Invalid entity returned")
    return
end

if type(Entity.SetCallback) == "function" then
    pcall(function()
        Entity:SetCallback("OnSpawned", function()
            task.defer(function()
                if Entity and Entity.Model then
                    ConfigureCrucifix(Entity.Model)
                end
            end)
        end)

        Entity:SetCallback("OnDespawned", function()
            GiveAchievement()
        end)
    end)
end

if type(Entity.Run) ~= "function" then
    warn("[Smiler] Entity.Run unavailable")
    return
end

local runOK, runError = pcall(function()
    Entity:Run()
end)

