local function ShowAchievement()
    if AchievementShown then return end
    AchievementShown = true

    pcall(function()
        DoorsNotify({
            Style = "mở khoá một thành tựu mới",
            Title = "Fought a beast and survived.",
            Description = "How?",
            Reason = "Survive wh1t3",
            Image = "93674549075813",
            Time = 5
        })
    end)
end

local function ActivateNeon(room)
    if not room then return end

    for _, v in ipairs(room:GetDescendants()) do
        if v:IsA("BasePart") and v.Material == Enum.Material.Neon then
            v.Color = Color3.fromRGB(255, 0, 0)
        elseif v:IsA("PointLight") or v:IsA("SpotLight")
            or v:IsA("SurfaceLight") then
            v.Color = Color3.fromRGB(255, 0, 0)
            v.Enabled = true
        end
    end
end

local function PlayJumpscare()
    if JumpscarePlaying then return end
    JumpscarePlaying = true

    local gui
    local sound
    local camera = Workspace.CurrentCamera
    local playerGui = Player:FindFirstChildOfClass("PlayerGui")

    if not camera or not playerGui then
        JumpscarePlaying = false
        return
    end

    local oldType = camera.CameraType
    local oldFov = camera.FieldOfView
    local oldSubject = camera.CameraSubject

    local ok, err = pcall(function()
        local oldGui = playerGui:FindFirstChild("WH1T3Jumpscare")
        if oldGui then oldGui:Destroy() end

        gui = Instance.new("ScreenGui")
        gui.Name = "WH1T3Jumpscare"
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10000
        gui.ResetOnSpawn = false
        gui.Parent = playerGui

        local bg = Instance.new("Frame")
        bg.Size = UDim2.fromScale(1, 1)
        bg.BackgroundColor3 = Color3.new(0, 0, 0)
        bg.BorderSizePixel = 0
        bg.Parent = gui

        local face = Instance.new("ImageLabel")
        face.AnchorPoint = Vector2.new(0.5, 0.5)
        face.Position = UDim2.fromScale(0.5, 0.5)
        face.Size = UDim2.fromScale(0.15, 0.15)
        face.BackgroundTransparency = 1
        face.Image = "rbxassetid://107126842178001"
        face.ScaleType = Enum.ScaleType.Fit
        face.Parent = gui

        local flash = Instance.new("Frame")
        flash.Size = UDim2.fromScale(1, 1)
        flash.BackgroundColor3 = Color3.fromRGB(0, 20, 180)
        flash.BackgroundTransparency = 1
        flash.BorderSizePixel = 0
        flash.ZIndex = 5
        flash.Parent = gui

        face.ZIndex = 3

        sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://5263560896"
        sound.Volume = 5
        sound.Parent = Workspace

        camera.CameraType = Enum.CameraType.Scriptable
        camera.FieldOfView = 40
        sound:Play()

        TweenService:Create(face, TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromScale(1.2, 1.2)
        }):Play()

        local start = os.clock()

        while os.clock() - start < 2 do
            flash.BackgroundTransparency = 0.2
            face.Rotation = math.random(-12, 12)
            camera.FieldOfView = math.random(35, 48)
            task.wait(0.07)

            flash.BackgroundTransparency = 1
            face.Rotation = math.random(-8, 8)
            task.wait(0.06)
        end

        TweenService:Create(face, TweenInfo.new(0.2), {
            ImageTransparency = 1
        }):Play()

        TweenService:Create(bg, TweenInfo.new(0.2), {
            BackgroundTransparency = 1
        }):Play()

        task.wait(0.25)
    end)

    if sound then sound:Destroy() end
    if gui then gui:Destroy() end

    if camera.Parent then
        camera.CameraType = oldType
        camera.FieldOfView = oldFov

        if oldSubject and oldSubject.Parent then
            camera.CameraSubject = oldSubject
        end
    end

    JumpscarePlaying = false

    if not ok then
        warn("[WH1T3] Jumpscare:", err)
    end
end

local function ShutdownOnDeath()
    if DeathHandled then return end
    DeathHandled = true

    task.spawn(ShowAchievement)

    task.spawn(function()
        pcall(PlayJumpscare)
        task.wait(0.5)

        pcall(function()
            game:Shutdown()
        end)
    end)
end

local function HookCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    humanoid.HealthChanged:Connect(function(health)
        if health <= 0 then
            ShutdownOnDeath()
        end
    end)

    humanoid.Died:Connect(ShutdownOnDeath)

    if humanoid.Health <= 0 then
        ShutdownOnDeath()
    end
end

if Player.Character then
    task.spawn(HookCharacter, Player.Character)
end

Player.CharacterAdded:Connect(function(character)
    if not DeathHandled then
        task.spawn(HookCharacter, character)
    end
end)

