entity:SetCallback("OnSpawned", function()
    local data = ReplicatedStorage:FindFirstChild("GameData")
    local latest = data and data:FindFirstChild("LatestRoom")
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    local room = rooms and latest and rooms:FindFirstChild(tostring(latest.Value))

    ActivateNeon(room)

    if room then
        room.DescendantAdded:Connect(function(v)
            if v:IsA("BasePart") and v.Material == Enum.Material.Neon then
                v.Color = Color3.fromRGB(255, 0, 0)
            elseif v:IsA("PointLight") or v:IsA("SpotLight")
                or v:IsA("SurfaceLight") then
                v.Color = Color3.fromRGB(255, 0, 0)
                v.Enabled = true
            end
        end)
    end

    task.spawn(function()
        local ok, err = pcall(function()
            if not isfile("wh1t3 pro.mp3") then
                writefile("wh1t3 pro.mp3", game:HttpGet(
                    "https://raw.githubusercontent.com/rrealblueyt-oss/Mp3/main/wh1t3_music.mp3"
                ))
            end

            local getAsset = getcustomasset or getsynasset
            if not getAsset then error("Asset loader unavailable") end

            local music = Instance.new("Sound")
            music.Name = "WH1T3Music"
            music.SoundId = getAsset("wh1t3 pro.mp3")
            music.Volume = 5
            music.Looped = false
            music.Parent = Workspace
            music:Play()
        end)

        if not ok then
            warn("[WH1T3] Music:", err)
        end
    end)
end)

entity:Run(true)
